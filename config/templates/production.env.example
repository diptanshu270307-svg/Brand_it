# ==============================================================================
# BrandLint Production Configuration Template
# ==============================================================================
APP_MODE=production

# Database: Hardened PostgreSQL with connection pool tuning and mandatory SSL
# Application user has DML-only permissions (SELECT, INSERT, UPDATE, DELETE).
DATABASE_URL=postgresql+psycopg://brandlint_app:PROD_STRONG_DB_PASSWORD@prod-db.internal:5432/brandlint_production?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-ca.pem

# Authentication: 64-char cryptographically secure secret (rotated via KMS)
SECRET_KEY=MUST_BE_AT_LEAST_32_CHAR_CRYPTOGRAPHICALLY_RANDOM_VALUE_FROM_KMS

# Session Governance (OWASP ASVS compliance)
TOKEN_TTL_MINUTES=480
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# Secure, HttpOnly, SameSite=Lax, __Host- prefix enforced automatically in production
DEV_COOKIE_SECURE=true

# Public Base URL: Must be https://
PUBLIC_BASE_URL=https://app.brandlint.com

# Mail: Production transactional SMTP with TLS
MAIL_PROVIDER=smtp
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=PROD_SES_ACCESS_KEY
SMTP_PASSWORD=PROD_SES_SECRET_KEY
SMTP_FROM=security@brandlint.com
SMTP_STARTTLS=true

# LLM Provider
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-PROD_KEY_FROM_SECRETS_MANAGER
LLM_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=40.0

# Distributed State & Throttling
REDIS_URL=rediss://:PROD_REDIS_AUTH_TOKEN@prod-redis.internal:6379/0
THROTTLING_BACKEND=redis

# CORS: Exact production domain (wildcards rejected at startup)
CORS_ORIGINS=https://app.brandlint.com

# Reverse Proxy / Ingress CIDRs
TRUSTED_PROXIES=10.0.0.0/16

# Quotas & Usage Accounting
WORKSPACE_MAX_MONTHLY_DRAFTS=2500
WORKSPACE_MAX_MONTHLY_CHECKS=10000
WORKSPACE_MAX_STORAGE_BYTES=5368709120
WORKSPACE_MAX_MEMBERS=250

# Resilient Job Execution
JOB_MAX_RETRIES=3
JOB_RETRY_BACKOFF_SECONDS=2.0
JOB_TIMEOUT_SECONDS=120
