# Environment mode: development | isolated-demo | production
# - isolated-demo: Local single-tenant demo with sample data, guided walkthrough and persona switching.
# - development: Local feature engineering, test suites and hot reload.
# - production: Multi-user company deployment. Refuses default/weak secrets, disables demo seeding, demo accounts and reset route.
APP_MODE=isolated-demo

# Database: PostgreSQL in docker-compose / production, SQLite for zero-setup local demo.
DATABASE_URL=sqlite:///./brandlint.db

# Auth: In production, SECRET_KEY must be at least 32 characters and cannot use default values.
SECRET_KEY=replace-with-a-long-random-value-before-deployment
DEMO_PASSWORD=demo1234

# Public origin used to build password reset links and validate CORS.
# In production, must be an https:// origin matching your reverse proxy domain.
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Reverse Proxy & TLS Configuration
# -----------------------------------------------------------------------------
# In production, place BrandLint behind an HTTPS reverse proxy (Nginx, Caddy, Cloudflare, AWS ALB).
# The reverse proxy terminates TLS and sets X-Forwarded-For and X-Forwarded-Proto: https.
# Configure TRUSTED_PROXIES with the IP or hostname of your reverse proxy or container network.
# Use "*" if running behind AWS ALB / Cloudflare ingress.
TRUSTED_PROXIES=127.0.0.1,::1,testclient

# -----------------------------------------------------------------------------
# Transactional Email (SMTP) Configuration
# -----------------------------------------------------------------------------
# MAIL_PROVIDER:
#   - dev-outbox: (Default in dev/demo) Writes emails to backend/.dev_outbox/ JSON files.
#   - smtp:       (Required for production delivery) Relays via real SMTP server.
#   - none:       Disables outgoing emails without failing startup.
MAIL_PROVIDER=dev-outbox

# Production SMTP Settings:
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_api_key_or_secret_here
SMTP_FROM=security@yourcompany.com
SMTP_STARTTLS=true
SMTP_SSL=false

# Examples for Common SMTP Providers:
# 1. SendGrid:
#    SMTP_HOST=smtp.sendgrid.net
#    SMTP_PORT=587
#    SMTP_USERNAME=apikey
#    SMTP_PASSWORD=<your-sendgrid-api-key>
#    SMTP_STARTTLS=true
#
# 2. Amazon SES:
#    SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#    SMTP_PORT=587
#    SMTP_USERNAME=<your-ses-smtp-username>
#    SMTP_PASSWORD=<your-ses-smtp-password>
#    SMTP_STARTTLS=true
#
# 3. Mailgun:
#    SMTP_HOST=smtp.mailgun.org
#    SMTP_PORT=587
#    SMTP_USERNAME=postmaster@mg.yourcompany.com
#    SMTP_PASSWORD=<your-mailgun-smtp-password>
#    SMTP_STARTTLS=true
#
# 4. Google Workspace:
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_USERNAME=notifications@yourcompany.com
#    SMTP_PASSWORD=<your-google-app-password>
#    SMTP_STARTTLS=true

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# LLM provider adapter (server side only). mock | openai | gemini
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=40

# Demo seeding: only active in isolated-demo and development modes.
SEED_ON_STARTUP=true
