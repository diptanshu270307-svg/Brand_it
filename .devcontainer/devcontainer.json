{
  "name": "BrandLint Full-Stack",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "BrandLint Live App",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postCreateCommand": "python3 -m pip install -r backend/requirements.txt && cd frontend && npm install && npm run build",
  "postStartCommand": "python3 -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000"
}
