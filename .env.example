# Database connection
# Use PostgreSQL in Docker / production:
# DATABASE_URL=postgresql+psycopg://brandlint:brandlint@localhost:5432/brandlint
# Default zero-setup local dev uses SQLite:
DATABASE_URL=sqlite:///./brandlint.db

# Authentication (JWT)
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-chars
TOKEN_TTL_MINUTES=480
DEMO_PASSWORD=demo1234

# Server-side LLM Provider Adapter: mock | openai | gemini
# Keep API keys server-side only; never expose them to the browser.
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=40

# Minimum override sample size before Guideline Health treats patterns as sufficient history
MIN_HEALTH_SAMPLE=5

# CORS & startup seeding
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
SEED_ON_STARTUP=true
