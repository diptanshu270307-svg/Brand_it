# ==============================================================================
# BrandLint Local Development Configuration Template (.env)
# ==============================================================================
APP_MODE=development

# Database: Local SQLite file for zero-setup development
DATABASE_URL=sqlite:///./brandlint.db

# Authentication: Development signing secret
SECRET_KEY=dev-local-secret-key-32-chars-long-secure-random

# Security & Sessions
TOKEN_TTL_MINUTES=480
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=24
DEV_COOKIE_SECURE=false

# Public Origin
PUBLIC_BASE_URL=http://localhost:5173

# Mail: Local outbox directory
MAIL_PROVIDER=dev-outbox
DEV_OUTBOX_DIR=backend/.dev_outbox

# LLM Provider: mock for zero-cost offline development
LLM_PROVIDER=mock

# CORS: Local frontend dev servers
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Workspace Usage Limits (Local Defaults)
WORKSPACE_MAX_MONTHLY_DRAFTS=500
WORKSPACE_MAX_MONTHLY_CHECKS=2000
WORKSPACE_MAX_STORAGE_BYTES=524288000
WORKSPACE_MAX_MEMBERS=50

# Job Execution
JOB_MAX_RETRIES=3
JOB_RETRY_BACKOFF_SECONDS=0.5
